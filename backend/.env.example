PORT=4000
NODE_ENV=development
JWT_SECRET=your-secure-jwt-secret-here
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# Database (sqlite | postgres)
DB_TYPE=sqlite
SQLITE_PATH=./codflow.sqlite
DATABASE_URL=

# Supabase / PostgreSQL credentials
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123456
DB_NAME=codflow

# WAHA WhatsApp Engine (https://github.com/devlikeapro/waha)
WAHA_API_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_MOCK_MODE=true


# CORS
CORS_ORIGIN=*

# Gemini AI Configuration
# Enable or disable Google Sheets column mapping verification via Gemini API (true/false)
ENABLE_GEMINI_SHEETS_AI=true
GEMINI_API_KEY=
